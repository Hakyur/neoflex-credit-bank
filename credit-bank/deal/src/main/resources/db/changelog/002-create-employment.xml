<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-create-employment" author="Dmitry Rogotovsky">
        <createTable tableName="employment">
            <column name="employment_id" type="UUID">
                <constraints primaryKey="true"/>
            </column>
            <column name="status" type="VARCHAR(50)"/>
            <column name="employer_inn" type="VARCHAR(12)"/>
            <column name="salary" type="NUMERIC(38,2)"/>
            <column name="position" type="VARCHAR(50)"/>
            <column name="work_experience_total" type="INT"/>
            <column name="work_experience_current" type="INT"/>
        </createTable>
    </changeSet>

</databaseChangeLog>