<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-passport" author="Dmitry Rogotovsky">
        <createTable tableName="passport">
            <column name="passport_id" type="UUID">
                <constraints primaryKey="true"/>
            </column>
            <column name="series" type="VARCHAR(4)"/>
            <column name="number" type="VARCHAR(6)"/>
            <column name="issue_branch" type="VARCHAR(255)"/>
            <column name="issue_date" type="DATE"/>
        </createTable>
    </changeSet>

</databaseChangeLog>